# Copy to .env.local. Workers is the only backend — there is no Medusa path.

# Workers API origin (required)
VITE_ALKEMART_API_URL=http://127.0.0.1:8787
# Seller workspace, for "Sell on alkemart" links
VITE_VENDOR_APP_URL=http://127.0.0.1:3002

# Market this storefront serves (code from @alkemart/shared/markets). Default GH.
# VITE_MARKET_CODE=GH

# Payments
# VITE_FEATURE_MOMO_LAB=true   # show Mobile Money (default off)
# VITE_FEATURE_CARD=0          # hide card (default on)

# Canonical origin for SEO tags (production)
# VITE_PUBLIC_SITE_URL=https://alkemart.com

# Optional analytics — the PUBLIC project key only (starts with phc_).
# Never a personal key (phx_…): that one is an account secret.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
