# Copy to .env.local for local lab.
# Production Pages builds should set VITE_ALKEMART_API_URL (Workers).
# Medusa vars are optional when Workers URL is set — dual-path legacy only.

# Cloudflare Workers API (preferred production path)
VITE_ALKEMART_API_URL=https://alkemart-api.glean-circular-passport.workers.dev

# Gold panel URLs
VITE_VENDOR_APP_URL=https://alkemart4-vendor.pages.dev
VITE_ADMIN_APP_URL=https://alkemart4-admin.pages.dev

# Optional: Medusa/Mercur backend — only needed for local dual-path without Workers URL
# VITE_MEDUSA_BACKEND_URL=
# VITE_MEDUSA_PUBLISHABLE_KEY=
# VITE_MEDUSA_REGION_ID=
# VITE_MEDUSA_SALES_CHANNEL_ID=

# Optional legacy panel aliases
# VITE_MERCUR_VENDOR_URL=
# VITE_MERCUR_ADMIN_URL=

# Optional product analytics (PostHog Cloud) — leave empty to disable
VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=

# Optional public site origin for canonical/OG URLs (production)
# VITE_PUBLIC_SITE_URL=https://shop.example.com

# Lab Mobile Money UI (default off — COD is the demo path)
# VITE_FEATURE_MOMO_LAB=true

# Error tracking (optional)
VITE_SENTRY_DSN=

# Prefer products with offer_id in browse/home lists (default true)
# VITE_FILTER_STORE_SELLABLE=true

# Production: keep 0 — demo catalog fill disabled
VITE_HOME_DEMO=0
