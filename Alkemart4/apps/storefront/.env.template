# Copy to .env.local for local or lab.
# Production Pages: set VITE_ALKEMART_API_URL to the Workers origin only.

# --- Local Workers (default for agents) ---
VITE_ALKEMART_API_URL=http://127.0.0.1:8787
VITE_VENDOR_APP_URL=http://127.0.0.1:3002
VITE_ADMIN_APP_URL=http://127.0.0.1:3001

# --- Live Pages / deployed Worker (example) ---
# VITE_ALKEMART_API_URL=https://alkemart-api.glean-circular-passport.workers.dev
# VITE_VENDOR_APP_URL=https://alkemart4-vendor.pages.dev
# VITE_ADMIN_APP_URL=https://alkemart4-admin.pages.dev

# Do not set VITE_MEDUSA_* for Workers development.

# Optional analytics / Sentry
VITE_PUBLIC_POSTHOG_KEY=
VITE_SENTRY_DSN=

# Lab MoMo UI (default off — COD is the demo path)
# VITE_FEATURE_MOMO_LAB=true

VITE_HOME_DEMO=0
