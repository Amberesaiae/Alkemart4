{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "bun run dev:workers",
    "dev:workers": "bash scripts/dev-workers.sh",
    "restart": "bash scripts/restart-local.sh",
    "dev:api": "bun run --filter @alkemart/api dev",
    "dev:storefront": "bun run --filter @workspace/storefront dev",
    "dev:vendor": "bun run --filter @alkemart/ghana-vendor dev",
    "dev:admin": "bun run --filter @acme/admin dev",
    "smoke": "bash scripts/e2e-workers-smoke.sh",
    "smoke:acid": "bash scripts/e2e-workers-acid.sh",
    "smoke:local": "ALKEMART_API_URL=http://127.0.0.1:8787 SKIP_PAGES=1 bash scripts/e2e-workers-smoke.sh",
    "smoke:acid:local": "ALKEMART_API_URL=http://127.0.0.1:8787 SKIP_PAGES=1 bash scripts/e2e-workers-acid.sh",
    "deploy:api": "bash -lc 'export NODE_OPTIONS=\"--dns-result-order=ipv4first${NODE_OPTIONS:+ $NODE_OPTIONS}\"; cd apps/api && wrangler deploy'",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "typecheck": "bun run --filter './apps/storefront' --filter './apps/api' --filter './scripts' typecheck",
    "setup": "bun install"
  },
  "private": true,
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "dependencies": {},
  "workspaces": [
    "apps/api",
    "apps/backend",
    "apps/backend/packages/api",
    "apps/backend/apps/admin",
    "apps/backend/apps/ghana-vendor",
    "apps/storefront",
    "packages/api-client",
    "packages/api-spec",
    "packages/db",
    "packages/domain",
    "packages/paystack",
    "packages/shared",
    "packages/ui",
    "scripts"
  ],
  "packageManager": "bun@1.3.14"
}
