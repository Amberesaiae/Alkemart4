{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "bun run dev:workers",
    "dev:workers": "bash scripts/dev-workers.sh",
    "restart": "bash scripts/restart-local.sh",
    "dev:api": "bun run --filter @alkemart/api dev",
    "dev:storefront": "bun run --filter @workspace/storefront dev",
    "dev:storefront-v2": "bun run --filter @workspace/storefront-v2 dev",
    "dev:vendor": "bun run --filter @alkemart/ghana-vendor dev",
    "dev:admin": "bun run --filter @acme/admin dev",
    "smoke": "bash scripts/e2e-workers-smoke.sh",
    "smoke:acid": "bash scripts/e2e-workers-acid.sh",
    "smoke:local": "ALKEMART_API_URL=http://127.0.0.1:8787 SKIP_PAGES=1 bash scripts/e2e-workers-smoke.sh",
    "smoke:acid:local": "ALKEMART_API_URL=http://127.0.0.1:8787 SKIP_PAGES=1 bash scripts/e2e-workers-acid.sh",
    "test:api": "bun run --cwd apps/api test --maxWorkers=2",
    "test:rls": "bun run --cwd apps/api test src/rls.test.ts --maxWorkers=1",
    "test:domain": "bun run --cwd packages/domain test --maxWorkers=2",
    "db:migrate": "bun scripts/apply-migrations.ts",
    "deploy:api": "bash -lc 'export NODE_OPTIONS=\"--dns-result-order=ipv4first${NODE_OPTIONS:+ $NODE_OPTIONS}\"; cd apps/api && wrangler deploy'",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "typecheck": "bun run --filter '*' typecheck",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:api-client": "bash scripts/check-api-client.sh",
    "setup": "bun install",
    "build": "bun run --filter '@workspace/storefront-v2' --filter '@workspace/vendor-v2' --filter '@workspace/admin-v2' build",
    "test": "bun run test:api && bun run test:domain && bun run test:storefront",
    "test:storefront": "bun run --filter '@workspace/storefront' test",
    "check": "bun run typecheck && bun run check:migrations && bun run check:api-client",
    "dev:vendor-v2": "bun run --filter @workspace/vendor-v2 dev",
    "dev:admin-v2": "bun run --filter @workspace/admin-v2 dev"
  },
  "private": true,
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postgres": "^3.4.5",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "dependencies": {},
  "workspaces": [
    "apps/api",
    "apps/backend",
    "apps/backend/packages/api",
    "apps/backend/apps/admin",
    "apps/backend/apps/ghana-vendor",
    "apps/storefront",
    "apps/storefront-v2",
    "packages/api-client",
    "packages/api-spec",
    "packages/db",
    "packages/domain",
    "packages/paystack",
    "packages/shared",
    "packages/ui",
    "scripts",
    "apps/vendor-v2",
    "apps/admin-v2",
    "packages/console-ui",
    "packages/maps"
  ],
  "packageManager": "bun@1.3.14"
}
